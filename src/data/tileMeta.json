{
  "_doc": "Authored semantic layer for the Kenney Pixel Platformer (Base) pack. Pairs with tileEdges.json (pixel-extracted edge geometry). The autotiler MERGES both by tile id: tileEdges.json supplies raw edge geometry; this file supplies biome/role/height/animation and AUTHORITATIVE edge OVERRIDES. Where a tile here has an 'edges' object, it WINS over tileEdges.json. Full prose reference: TILE_DICTIONARY.md.",
  "grid": { "cols": 20, "rows": 9, "tileSize": 18, "idFormula": "id = row*20 + col" },
  "edgeValues": ["open", "closed", "empty"],
  "edgeMeaning": "open = terrain/fill continues off this side (joins a neighbour); closed = a drawn border caps this side (nothing attaches); empty = transparent (object tile).",

  "autotile": {
    "_note": "Surface variant order within each tuple is [isolated, openRight, openLeftRight, openLeft], matching the calibrated edge reads (0=[],1=[right],2=[left,right],3=[left]). The autotiler indexes the tuple directly from the horizontal neighbour mask; it does NOT need tileEdges.json for surfaces. For FILL it must match by edge signature from tileEdges.json.",
    "surfaceVariantOrder": ["isolated", "openRight", "openLeftRight", "openLeft"],
    "surface": {
      "grass": { "thin": [0, 1, 2, 3],    "tall": [20, 21, 22, 23] },
      "sand":  { "thin": [40, 41, 42, 43], "tall": [60, 61, 62, 63] },
      "ice":   { "thin": [80, 81, 82, 83], "tall": [100, 101, 102, 103] }
    },
    "fill": {
      "dirt": [4, 5, 24, 25, 104, 120, 121, 122, 123, 140, 141, 142, 143],
      "_match": "For a fill cell, build the needed signature {side: open if neighbour solid, closed if neighbour air} and pick the dirt tile whose tileEdges.json signature matches. No exact match -> choose the candidate matching the most sides, preferring the all-open interior tile for fully-buried cells."
    }
  },

  "animationPairs": {
    "_note": "Loop these frame-pairs (same technique as the character walk cycle) for motion.",
    "water_surface": [33, 53],
    "waterfall_top": [34, 35],
    "waterfall_mid": [54, 55],
    "waterfall_bottom": [74, 75],
    "jump_pad": [107, 108],
